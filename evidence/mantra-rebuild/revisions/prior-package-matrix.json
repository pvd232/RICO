mplementation_review","viper_registration"],"depends_on":["P4-PB-05T"],"id":"P4-PB-06I","repository_id":"mantra","requirement_contribution":"Rebuild ptm and reproduce its historical intermediate before applying deterministic compression.","requirement_ids":["P4-REQ-06"]},{"completion_evidence":["implementation_review","viper_registration"],"depends_on":["P4-PB-05"],"id":"P4-PB-06J","repository_id":"mantra","requirement_contribution":"Bind the five completion-model inputs and execute the mechanistic256 compressed-array build.","requirement_ids":["P4-REQ-06"]},{"completion_evidence":["implementation_review","viper_registration"],"depends_on":["P4-PB-05"],"id":"P4-PB-06K","repository_id":"mantra","requirement_contribution":"Bind the five regulatory source matrices and execute the regulatory256 compressed-array build.","requirement_ids":["P4-REQ-06"]},{"completion_evidence":["implementation_review","viper_registration"],"depends_on":["P4-PB-06A","P4-PB-06B","P4-PB-06C","P4-PB-06D","P4-PB-06E","P4-PB-06F","P4-PB-06G","P4-PB-06H","P4-PB-06I","P4-PB-06J","P4-PB-06K"],"id":"P4-PB-06","repository_id":"mantra","requirement_contribution":"Freeze one corrected, provenance-complete prior bundle, restore it from GCS, and make it the only prior input for both model rebuilds.","requirement_ids":["P4-REQ-06"]}],"requirements":[{"claim":"Before corrected reconstruction begins, the inventory must distinguish raw biological sources, transformed prior blocks, and final model inputs. It must account explicitly for the eleven arrays in the retained compressed prior bundle\u2014corum, depmap_essentiality, dorothea_grn, gene_family, mechanistic256, motif, pathway_hallmark, ppi_spectral, ptm, regulatory256, and subcellular\u2014and resolve every model-consumed prior to its raw sources, typed ingest, biological identity joins, transformation parameters, output arrays, historical counterpart, and demonstrated reconstruction boundary.","depends_on":["D3-REQ-06"],"id":"P4-REQ-01","verifier_ids":["P4-VR-01"]},{"claim":"Each selected prior source must be reacquired or restored through one VIPER stage that retains the exact request, source version, raw bytes, parser inputs, typed output, and failures without writing partial downloads to final paths.","depends_on":["P4-REQ-01"],"id":"P4-REQ-02","verifier_ids":["P4-VR-02"]},{"claim":"A perturbation that resolves to a current pseudogene must remain on the experimental row axis, retain its current gene identity and locus type, and mark protein-derived modalities missing instead of dropping the row or fabricating protein evidence.","depends_on":["P4-REQ-02"],"id":"P4-REQ-03","verifier_ids":["P4-VR-03"]},{"claim":"The interaction prior must parse every byte of each pinned source, preserve source attribution for every accepted edge, report per-source and union coverage, and reject a truncated or concurrently changing source before dimensional reduction.","depends_on":["P4-REQ-03"],"id":"P4-REQ-04","verifier_ids":["P4-VR-04"]},{"claim":"Every non-interaction prior selected for the rebuilt models must be reconstructed from its pinned typed sources and report unresolved perturbations, missing modalities, duplicate identities, row order, dimensions, dtypes, and transformation parameters.","depends_on":["P4-REQ-04"],"id":"P4-REQ-05","verifier_ids":["P4-VR-05"]},{"claim":"One corrected prior bundle must preserve the canonical perturbation order, distinguish observed values from missing modalities, and bind every array to its source and build evidence for downstream model stages.","depends_on":["P4-REQ-05"],"id":"P4-REQ-06","verifier_ids":["P4-VR-06"]}],"schema_version":1,"title":"MANTRA Prior Reconstruction","verifiers":[{"acceptance_conditions":["The inventory accounts for every model-consumed prior; separately names the eleven retained compressed-bundle arrays; and records each source, producer, transformation, historical identity, current reconstruction status, and first unresolved connector without treating an assembled block as a raw source."],"id":"P4-VR-01","rejection_cases":[{"path":"src/mantra/rebuild/tests/test_prior_inventory.py","repository_id":"mantra","symbol":"test_rejects_unowned_or_unresolved_prior"}],"requirement_ids":["P4-REQ-01"],"success_case":{"path":"src/mantra/rebuild/tests/test_prior_inventory.py","repository_id":"mantra","symbol":"test_inventory_accounts_for_every_consumed_prior"}},{"acceptance_conditions":["Each download or restoration publishes only verified complete bytes and the VIPER record reaches the request, source identity, parser, typed output, and failure state."],"id":"P4-VR-02","rejection_cases":[{"path":"src/mantra/rebuild/tests/test_prior_sources.py","repository_id":"mantra","symbol":"test_rejects_partial_or_unpinned_prior_source"}],"requirement_ids":["P4-REQ-02"],"success_case":{"path":"src/mantra/rebuild/tests/test_prior_sources.py","repository_id":"mantra","symbol":"test_acquires_and_ingests_prior_sources"}},{"acceptance_conditions":["The ALG1L experimental row resolves to the current ALG1L1P gene record and carries explicit missingness for protein-derived inputs while remaining present in every split and output axis."],"id":"P4-VR-03","rejection_cases":[{"path":"src/mantra/rebuild/tests/test_pseudogene_policy.py","repository_id":"mantra","symbol":"test_rejects_dropped_row_or_fabricated_protein_identity"}],"requirement_ids":["P4-REQ-03"],"success_case":{"path":"src/mantra/rebuild/tests/test_pseudogene_policy.py","repository_id":"mantra","symbol":"test_preserves_pseudogene_perturbation_with_modality_masks"}},{"acceptance_conditions":["The parser consumes the complete pinned IntAct bytes, reports accepted pairs and covered perturbations, and rejects the known 1,170,222,081-byte historical prefix as incomplete."],"id":"P4-VR-04","rejection_cases":[{"path":"src/mantra/rebuild/tests/test_interaction_prior.py","repository_id":"mantra","symbol":"test_rejects_historical_intact_prefix"}],"requirement_ids":["P4-REQ-04"],"success_case":{"path":"src/mantra/rebuild/tests/test_interaction_prior.py","repository_id":"mantra","symbol":"test_rebuilds_interactions_from_complete_sources"}},{"acceptance_conditions":["Each selected prior rebuild preserves canonical row order and emits complete identity, coverage, missingness, source, and transformation reports before model fitting."],"id":"P4-VR-05","rejection_cases":[{"path":"src/mantra/rebuild/tests/test_prior_reconstruction.py","repository_id":"mantra","symbol":"test_rejects_missing_or_misaligned_prior_rows"}],"requirement_ids":["P4-REQ-05"],"success_case":{"path":"src/mantra/rebuild/tests/test_prior_reconstruction.py","repository_id":"mantra","symbol":"test_rebuilds_selected_noninteraction_priors"}},{"acceptance_conditions":["The frozen bundle contains one ordered row per perturbation, one observation mask per modality, and a verified provenance path from every array to its raw source and builder."],"id":"P4-VR-06","rejection_cases":[{"path":"src/mantra/rebuild/tests/test_prior_bundle.py","repository_id":"mantra","symbol":"test_rejects_unattributed_or_implicit_missing_values"}],"requirement_ids":["P4-REQ-06"],"success_case":{"path":"src/mantra/rebuild/tests/test_prior_bundle.py","repository_id":"mantra","symbol":"test_freezes_corrected_prior_bundle"}}]},"accepted_package_sha256":"d17f7d366d54a31d939e6027aaa3f01244db6d8dbe1773e5478ee81e023be740","affected_pair_block_ids":["B9-PB-01","B9-PB-02","GE-PB-01","GE-PB-02","GE-PB-03","GE-PB-04","GE-PB-05","GE-PB-06","H7-PB-01","H7-PB-02","H7-PB-03","H7-PB-04","H7-PB-05","M8-PB-01","M8-PB-02","M8-PB-03","M8-PB-04","M8-PB-05","M8-PB-06","P4-PB-04","P4-PB-05","P4-PB-05A","P4-PB-05B","P4-PB-05C","P4-PB-05D","P4-PB-05E","P4-PB-05F","P4-PB-05G","P4-PB-05H","P4-PB-05I","P4-PB-05J","P4-PB-05K","P4-PB-05L","P4-PB-05M","P4-PB-05N","P4-PB-05O","P4-PB-05P","P4-PB-05Q","P4-PB-05S","P4-PB-05T","P4-PB-05U","P4-PB-05V","P4-PB-05W","P4-PB-05X","P4-PB-05Y","P4-PB-05Z","P4-PB-06","P4-PB-06A","P4-PB-06B","P4-PB-06C","P4-PB-06D","P4-PB-06E","P4-PB