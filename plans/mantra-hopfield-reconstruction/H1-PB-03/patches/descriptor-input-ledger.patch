+def descriptor_input_ledger(source: GitSource) -> tuple[dict[str, object], ...]:
+    """Describe the four retained descriptor files and their exact Git restore routes.
+
+    The producer reports name the matched-control and control-program inputs used
+    to make ``core83`` and ``gene_shift``. The restore references deliberately
+    point to the retained outputs instead: Phase 1 restores approved bytes and
+    does not rerun those upstream producers.
+    """
+
+    return tuple(
+        {
+            "name": name,
+            "identity": INPUTS[name].identity.model_dump(mode="json"),
+            "producer_record": DESCRIPTOR_INPUT_PRODUCERS[name],
+            "restore": GitFileRef(
+                repository=source.repository,
+                commit=source.commit,
+                path=INPUTS[name].path,
+            ).model_dump(mode="json"),
+        }
+        for name in DESCRIPTOR_INPUT_NAMES
+    )
+
+
+def restore_descriptor_inputs(
+    repository_root: Path,
+    destination: Path,
+    *,
+    source: GitSource,
+) -> dict[str, Path]:
+    """Restore and verify the descriptor ledger without running its producers."""
+
+    restored: dict[str, Path] = {}
+    for record in descriptor_input_ledger(source):
+        name = str(record["name"])
+        declared = INPUTS[name]
+        try:
+            completed = subprocess.run(
+                (
+                    "git",
+                    "-C",
+                    str(repository_root),
+                    "show",
+                    f"{source.commit}:{declared.path}",
+                ),
+                check=True,
+                capture_output=True,
+            )
+        except (OSError, subprocess.CalledProcessError) as error:
+            raise HopfieldReplayError(f"cannot restore descriptor input: {name}") from error
+        if (
+            len(completed.stdout) != declared.identity.bytes
+            or hashlib.sha256(completed.stdout).hexdigest() != declared.identity.sha256
+        ):
+            raise HopfieldReplayError(f"replay input identity differs: {name}")
+        target = destination / declared.path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(completed.stdout)
+        restored[name] = target
+    return restored
+
