@@ -0,0 +1,90 @@
+"""Verify exact restoration of the selected Hopfield descriptor inputs."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+import numpy as np
+import pytest
+from viper.references import GitSource
+
+import mantra.rebuild.hopfield_replay as replay
+from mantra.rebuild.hopfield_replay import (
+    DESCRIPTOR_INPUT_NAMES,
+    DESCRIPTOR_INPUT_PRODUCERS,
+    INPUTS,
+    HopfieldReplayError,
+    descriptor_input_ledger,
+    restore_descriptor_inputs,
+)
+
+
+def _source() -> GitSource:
+    """Pin restoration to the commit that retained the approved descriptor files."""
+
+    return GitSource(
+        repository="https://github.com/pvd232/MANTRA.git",
+        commit="a23bf766b70941afa7c8b0fdc64b7ca1326d461b",
+    )
+
+
+def _assert_same_npz(left: Path, right: Path) -> None:
+    """Require equal keys, ordered axes, shapes, dtypes, and array values."""
+
+    with (
+        np.load(left, allow_pickle=True) as observed,
+        np.load(right, allow_pickle=True) as expected,
+    ):
+        assert observed.files == expected.files
+        for key in expected.files:
+            assert observed[key].shape == expected[key].shape
+            assert observed[key].dtype == expected[key].dtype
+            assert np.array_equal(observed[key], expected[key])
+
+
+def test_restores_selected_descriptor_inputs(tmp_path: Path) -> None:
+    """Restore every descriptor file and reproduce its complete NPZ content."""
+
+    repository_root = Path(__file__).parents[4]
+    source = _source()
+    ledger = descriptor_input_ledger(source)
+
+    assert tuple(record["name"] for record in ledger) == DESCRIPTOR_INPUT_NAMES
+    assert all(record["producer_record"] for record in ledger)
+    assert all(
+        (repository_root / DESCRIPTOR_INPUT_PRODUCERS[name]).is_file()
+        for name in DESCRIPTOR_INPUT_NAMES
+    )
+
+    restored = restore_descriptor_inputs(
+        repository_root,
+        tmp_path,
+        source=source,
+    )
+    for name, restored_path in restored.items():
+        _assert_same_npz(restored_path, repository_root / INPUTS[name].path)
+
+
+def test_rejects_changed_descriptor_input(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Reject a Git-restored descriptor whose bytes differ from its ledger identity."""
+
+    repository_root = Path(__file__).parents[4]
+    source = _source()
+    real_run = replay.subprocess.run
+
+    def changed_run(*args: object, **kwargs: object) -> subprocess.CompletedProcess[bytes]:
+        completed = real_run(*args, **kwargs)
+        return subprocess.CompletedProcess(
+            completed.args,
+            completed.returncode,
+            completed.stdout + b"changed",
+            completed.stderr,
+        )
+
+    monkeypatch.setattr(replay.subprocess, "run", changed_run)
+    with pytest.raises(HopfieldReplayError, match="replay input identity differs"):
+        restore_descriptor_inputs(repository_root, tmp_path, source=source)
