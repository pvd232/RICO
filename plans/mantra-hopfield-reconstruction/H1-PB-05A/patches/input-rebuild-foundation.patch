@@ -0,0 +1,85 @@
+"""Test terminal decisions for direct Hopfield input reconstruction."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from mantra.rebuild.hopfield_input_rebuild import (
+    classify_rebuilt_input,
+    compare_rebuilt_input,
+    copy_versioned_input,
+)
+
+
+def _context(inputs: dict[str, Path], outputs: dict[str, Path]) -> object:
+    """Return the path surface used by a VIPER Build worker."""
+
+    return SimpleNamespace(inputs=inputs, outputs=outputs)
+
+
+def test_reconstructs_every_hopfield_input_from_its_true_source(tmp_path: Path) -> None:
+    """Accept exact repeated materialization of one versioned source input."""
+
+    source = tmp_path / "source.yaml"
+    source.write_text("seed: 0\n", encoding="utf-8")
+    first = tmp_path / "first.yaml"
+    second = tmp_path / "second.yaml"
+    copy_versioned_input(_context({"source": source}, {"rebuilt": first}))
+    copy_versioned_input(_context({"source": source}, {"rebuilt": second}))
+
+    comparison = compare_rebuilt_input(source, first, second)
+
+    assert comparison.classification == "exact"
+    assert comparison.repeated_builds_equal
+
+
+def test_accepts_reproducible_numerical_replacement(tmp_path: Path) -> None:
+    """Keep a repeated modern numeric result distinct from historical parity."""
+
+    historical = tmp_path / "historical.npz"
+    first = tmp_path / "first.npz"
+    second = tmp_path / "second.npz"
+    np.savez(historical, values=np.array([1.0, 2.0], dtype=np.float32))
+    np.savez(first, values=np.array([1.0, 2.000001], dtype=np.float32))
+    second.write_bytes(first.read_bytes())
+
+    comparison = compare_rebuilt_input(historical, first, second)
+
+    assert comparison.classification == "numerical_divergence"
+    assert comparison.arrays["values"].max_absolute_difference == pytest.approx(9.5367431640625e-7)
+
+
+def test_rejects_incomplete_or_unexplained_input_reconstruction(
+    tmp_path: Path,
+) -> None:
+    """Reject a proposed baseline when its repeated Build bytes disagree."""
+
+    historical = tmp_path / "historical.bin"
+    first = tmp_path / "first.bin"
+    second = tmp_path / "second.bin"
+    receipt = tmp_path / "receipt.json"
+    historical.write_bytes(b"historical")
+    first.write_bytes(b"first")
+    second.write_bytes(b"second")
+
+    with pytest.raises(ValueError, match="repeated input builds differ"):
+        classify_rebuilt_input(
+            _context(
+                {
+                    "historical": historical,
+                    "first_build": first,
+                    "second_build": second,
+                },
+                {"receipt": receipt},
+            )
+        )
+
+
+def test_rejects_retained_input_in_rebuilt_replay() -> None:
+    """Reserve the final observer for the rebuilt-only FutureInputRef graph."""
+
+    pytest.skip("activated by H1-PB-05 after all thirteen inputs are accepted")
