+def run_rebuilt_hopfield_replay(
+    repository_root: Path,
+    restoration_run: ResolvedRunRef,
+    *,
+    device: str = "cpu",
+):
+    """Execute the strict replay from thirteen in-run Build outputs."""
+
+    source = read_source(repository_root)
+    environment = LocalEnvSpec(
+        compute=_compute_for_device(device),
+        lockfile=GitFileRef(
+            repository=source.repository,
+            commit=source.commit,
+            path="pyproject.toml",
+        ),
+        python_env=observe_python_env(),
+    )
+    cloud_client = load_viper_cloud_client(repository_root)
+    return execution.run(
+        plan(
+            experiment=build_rebuilt_hopfield_study(
+                restoration_run,
+                source_commit=source.commit,
+                device=device,
+                repository_root=repository_root,
+            ),
+            source=source,
+            env=environment,
+        ),
+        repository_root=repository_root,
+        cloud_client=cloud_client,
+    )
+
