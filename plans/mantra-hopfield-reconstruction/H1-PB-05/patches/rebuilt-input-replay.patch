+def build_rebuilt_hopfield_study(
+    restoration_run: ResolvedRunRef,
+    *,
+    source_commit: str,
+    device: str = "cpu",
+    repository_root: Path | None = None,
+):
+    """Feed thirteen accepted Build outputs into the strict Hopfield replay."""
+
+    build_stages = []
+    model_inputs: dict[str, StageInputDraft | InputBinding] = {}
+    for name, declared in INPUTS.items():
+        source_path = _physical_input_path(repository_root, declared.path)
+        suffix = Path(source_path).suffix or ".bin"
+        built = stage(
+            copy_versioned_input,
+            stage_id=f"build_{name}",
+            config=BuildConfig(),
+            inputs=(input("source", path=source_path, data_role="training"),),
+            outputs=StageOutputs(
+                rebuilt=output(
+                    path=f"accepted-inputs/{name}{suffix}",
+                    loader=load_bytes,
+                    data_role="training",
+                )
+            ),
+            file_access="declared",
+        )
+        build_stages.append(built)
+        model_inputs[name] = input(name, source=built.outputs["rebuilt"])
+    embedding, prediction, evaluation = _hopfield_stages(
+        model_inputs=model_inputs,
+        historical_raw_gene_predictions=input(
+            "historical_raw_gene_predictions",
+            path=_physical_input_path(repository_root, HISTORICAL_RAW_GENE_PREDICTIONS[0]),
+            data_role="benchmark",
+        ),
+        device=device,
+    )
+    return experiment(
+        experiment_id=(
+            f"mantra_hopfield_rebuilt_{source_commit[:12]}_{restoration_run.sha256[:12]}"
+        ),
+        variants=(
+            variant(
+                "selected",
+                stages=(*build_stages, embedding, prediction, evaluation),
+                estimator=evaluation.outputs.parity_receipt,
+            ),
+        ),
+        replicates=(replicate(seed=0),),
+    )
+
+
