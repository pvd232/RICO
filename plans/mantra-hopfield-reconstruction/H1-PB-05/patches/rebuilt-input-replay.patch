+def test_rebuilt_study_consumes_thirteen_future_inputs(tmp_path: Path) -> None:
+    """Connect every accepted Build output to the model without retained inputs."""
+
+    study = build_rebuilt_hopfield_study(
+        _restoration_run(tmp_path),
+        source_commit="0" * 40,
+        repository_root=tmp_path,
+    )
+    selected = study.variants["selected"]
+    embedding = selected.stages["embed"]
+    prediction = selected.stages["predict"]
+    evaluation = selected.stages["evaluate"]
+
+    assert {stage_id for stage_id in selected.stages if stage_id.startswith("build_")} == {
+        f"build_{name}" for name in hopfield_replay.INPUTS
+    }
+    for name in hopfield_replay.INPUTS:
+        consumer = evaluation if name == "hold_truth" else embedding
+        assert consumer.spec.inputs[name].producer.stage_id == f"build_{name}"
+    assert set(prediction.spec.inputs) == {
+        "encoder",
+        *(name for name in hopfield_replay.INPUTS if name != "hold_truth"),
+    }
+    historical = evaluation.spec.inputs["historical_raw_gene_predictions"]
+    assert historical.path == hopfield_replay.HISTORICAL_RAW_GENE_PREDICTIONS[0]
+    assert historical.data_role == "benchmark"
+
