+def target_input_bindings(path: Path) -> tuple[RestorationBinding, ...]:
+    """Load the five archive bindings consumed before replay training.
+
+    The retained binding record is the ledger: each row joins the historical
+    destination to its content digest and its signed Hugging Face archive
+    member. This function checks that those rows still agree with ``INPUTS`` so
+    the replay and restoration paths cannot silently select different bytes.
+    """
+
+    bindings = load_restoration_bindings(path)
+    by_destination = {binding.destination: binding for binding in bindings}
+    if len(by_destination) != len(bindings):
+        raise RestorationBindingError("target-input destinations must be unique")
+
+    selected: list[RestorationBinding] = []
+    for name in TARGET_INPUT_NAMES:
+        declared = INPUTS[name]
+        binding = by_destination.get(declared.path)
+        if binding is None:
+            raise RestorationBindingError(f"target-input binding is absent: {name}")
+        if declared.source is not ReplayInputSource.RESTORATION_RUN:
+            raise RestorationBindingError(f"target input has no restoration route: {name}")
+        if binding.expected != declared.identity:
+            raise RestorationBindingError(f"target-input identity differs: {name}")
+        selected.append(binding)
+
+    if len(bindings) != len(selected):
+        selected_destinations = {binding.destination for binding in selected}
+        unexpected = sorted(set(by_destination) - selected_destinations)
+        raise RestorationBindingError(f"target-input ledger has unexpected rows: {unexpected}")
+    return tuple(selected)
+
+
+def target_input_ledger(path: Path) -> tuple[dict[str, object], ...]:
+    """Describe each target's producer, identity, and signed restore route."""
+
+    return tuple(
+        {
+            "name": name,
+            "producer": TARGET_INPUT_PRODUCER,
+            "identity": binding.expected.model_dump(mode="json"),
+            "restore": binding.to_mapping()["source"],
+        }
+        for name, binding in zip(TARGET_INPUT_NAMES, target_input_bindings(path), strict=True)
+    )
+
+
+def restore_target_inputs(
+    binding_path: Path,
+    *,
+    parts: Sequence[ArchivePart],
+    cache_directory: Path,
+    destination: Path,
+) -> tuple[ArchiveExtraction, ...]:
+    """Restore the target-input ledger through the verified archive reader."""
+
+    bindings = target_input_bindings(binding_path)
+    return restore_bound_files(
+        bindings=bindings,
+        parts=parts,
+        cache_directory=cache_directory,
+        output_paths={
+            binding.destination: destination / binding.destination for binding in bindings
+        },
+    )
+
+
